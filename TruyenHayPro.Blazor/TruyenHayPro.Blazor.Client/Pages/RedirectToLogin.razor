@inject NavigationManager Navigation

@code {
    // DÙNG HÀM NÀY: Chỉ chạy sau khi giao diện đã render xong (thường là ở Client)
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Lấy URL hiện tại
            var returnUrl = Navigation.Uri;

            // Redirect dùng tham số 'returnUrl' (chữ thường) để phân biệt
            Navigation.NavigateTo($"Login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
        }

        return Task.CompletedTask;
    }

}