@page "/edit-chapter/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using TruyenHayPro.Blazor.Client.Services
@attribute [Authorize]

@inject ClientChapterService ChapterService
@inject NavigationManager Navigation

<PageTitle>Sửa Chương - TruyenHayPro</PageTitle>

<div class = "container py-4">
    <div class = "d-flex align-items-center justify-content-between mb-4">
        <div class = "d-flex align-items-center gap-3">
            <button class = "btn btn-outline-secondary btn-sm" @onclick = "GoBack" title = "Quay lại">
                <i class = "bi bi-arrow-left"></i>
            </button>
            <h3 class = "mb-0 fw-bold text-primary">
                <i class = "bi bi-pencil-square me-2"></i>Hiệu Chỉnh Chương
            </h3>
        </div>
    </div>

    @if (isLoading)
    {
        <div class = "text-center py-5">
            <div class = "spinner-border text-primary" role = "status"></div>
            <p class = "mt-2 text-muted">Đang tải dữ liệu...</p>
        </div>
    }
    else
    {
        <div class = "card shadow-sm border-0 rounded-3">
            <div class = "card-body p-4">
                <EditForm Model = "@model" OnValidSubmit = "HandleSubmit">
                    <DataAnnotationsValidator/>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class = "alert alert-danger d-flex align-items-center mb-4" role = "alert">
                            <i class = "bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@errorMessage</div>
                        </div>
                    }

                    <div class = "row g-3 mb-4">
                        <div class = "col-md-2 col-sm-3">
                            <label class = "form-label fw-bold text-muted small text-uppercase">Số chương</label>
                            <div class = "input-group">
                                <span class = "input-group-text bg-light border-end-0">#</span>
                                <InputNumber @bind-Value = "model.ChapterNumber" class = "form-control border-start-0 ps-0 fw-bold" placeholder = "1"/>
                            </div>
                            <ValidationMessage For = "@(() => model.ChapterNumber)" class = "text-danger small mt-1"/>
                        </div>

                        <div class = "col-md-10 col-sm-9">
                            <label class = "form-label fw-bold text-muted small text-uppercase">Tiêu đề chương</label>
                            <InputText @bind-Value = "model.Title" class = "form-control fw-bold" placeholder = "Ví dụ: Mở đầu"/>
                            <ValidationMessage For = "@(() => model.Title)" class = "text-danger small mt-1"/>
                        </div>
                    </div>

                    <div class = "mb-4">
                        <label class = "form-label fw-bold text-muted small text-uppercase d-flex justify-content-between">
                            <span>Nội dung chương</span>
                            <span class = "fw-normal">@(model.Content?.Length ?? 0) ký tự</span>
                        </label>
                        <InputTextArea
                            @bind-Value = "model.Content"
                            class = "form-control content-editor"
                            placeholder = "Nhập nội dung chương tại đây..."
                            rows = "15"
                        />
                        <ValidationMessage For = "@(() => model.Content)" class = "text-danger small mt-1"/>
                    </div>

                    <div class = "d-flex justify-content-end gap-2 pt-3 border-top">
                        <button type = "button" class = "btn btn-light px-4" @onclick = "GoBack">Hủy bỏ</button>
                        <button type = "submit" class = "btn btn-primary px-4 fw-bold" disabled = "@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class = "spinner-border spinner-border-sm me-2"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <i class = "bi bi-check-lg me-2"></i>
                                <span>Lưu Thay Đổi</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>