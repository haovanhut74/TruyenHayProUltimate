@page "/manage-chapters/{NovelId:guid}"
@using Microsoft.AspNetCore.Authorization
@using TruyenHayPro.Application.Common.Interfaces.Services
@using TruyenHayPro.Blazor.Client.Services
@attribute [Authorize]

@inject ClientChapterService ChapterService
@inject INovelService NovelService

@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Quản Lý Chương - TruyenHayPro</PageTitle>

<div class = "container py-4">
    <div class = "d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div class = "d-flex align-items-center gap-3">
            <button class = "btn btn-outline-secondary btn-sm rounded-circle p-2 lh-1" @onclick = "GoBack" title = "Quay lại">
                <i class = "bi bi-arrow-left"></i>
            </button>
            <div>
                <h3 class = "mb-0 fw-bold text-primary">
                    <i class = "bi bi-list-columns-reverse me-2"></i>Quản Lý Chương
                </h3>
                @if (!string.IsNullOrEmpty(novelTitle))
                {
                    <small class = "text-muted">Truyện: <strong>@novelTitle</strong></small>
                }
            </div>
        </div>

        <div class = "d-flex gap-2">
            <div class = "input-group search-box">
                <span class = "input-group-text bg-white border-end-0"><i class = "bi bi-search text-muted"></i></span>
                <input type = "text" class = "form-control border-start-0 ps-0" placeholder = "Tìm chương..." @bind = "searchText" @bind:event = "oninput"/>
            </div>

            <button class = "btn btn-primary fw-bold d-flex align-items-center gap-2 px-3" @onclick = "CreateChapter">
                <i class = "bi bi-plus-lg"></i>
                <span class = "d-none d-sm-inline">Thêm Chương</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class = "text-center py-5">
            <div class = "spinner-border text-primary" role = "status"></div>
            <p class = "mt-2 text-muted">Đang tải danh sách chương...</p>
        </div>
    }
    else if (!chapters.Any())
    {
        <div class = "empty-state text-center py-5 rounded-3 bg-light border border-dashed">
            <i class = "bi bi-journal-album text-muted display-4 mb-3"></i>
            <h5 class = "fw-bold text-secondary">Chưa có chương nào</h5>
            <p class = "text-muted mb-4">Hãy bắt đầu viết chương đầu tiên cho tác phẩm của bạn.</p>
            <button class = "btn btn-primary" @onclick = "CreateChapter">Viết ngay</button>
        </div>
    }
    else
    {
        <div class = "card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class = "table-responsive">
                <table class = "table table-hover align-middle mb-0">
                    <thead class = "bg-light">
                    <tr>
                        <th scope = "col" class = "ps-4 text-muted text-uppercase small fw-bold" style = "width: 80px;">
                            Số
                        </th>
                        <th scope = "col" class = "text-muted text-uppercase small fw-bold">Tiêu đề chương</th>
                        <th scope = "col" class = "text-muted text-uppercase small fw-bold" style = "width: 150px;">Ngày
                            đăng
                        </th>
                        <th scope = "col" class = "text-end pe-4 text-muted text-uppercase small fw-bold" style = "width: 150px;">
                            Hành động
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var chapter in FilteredChapters)
                    {
                        <tr>
                            <td class = "ps-4 fw-bold text-secondary">#@chapter.OrderIndex</td>
                            <td>
                                <span class = "fw-semibold text-dark">@chapter.Title</span>
                                <div class = "small text-muted d-sm-none">@chapter.CreatedDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class = "text-muted small d-none d-sm-table-cell">
                                @chapter.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class = "text-end pe-4">
                                <div class = "btn-group">
                                    <button class = "btn btn-light btn-sm text-primary" @onclick = "() => EditChapter(chapter.Id)" title = "Sửa">
                                        <i class = "bi bi-pencil-fill"></i>
                                    </button>
                                    <button class = "btn btn-light btn-sm text-danger ms-1" @onclick = "() => DeleteChapter(chapter.Id)" title = "Xóa">
                                        <i class = "bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class = "mt-3 text-muted small text-end">
            Tổng cộng: <strong>@FilteredChapters.Count()</strong> chương
        </div>
    }
</div>

